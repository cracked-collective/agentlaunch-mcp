{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cracked-collective/agentlaunch",
  "title": "AgentLaunch",
  "description": "Plan and run paced startup, SaaS and AI directory launches from your agent, in your own Chrome.",
  "version": "2.0.0",
  "websiteUrl": "https://www.agentlaun.ch/docs#mcp",
  "repository": {
    "url": "https://github.com/cracked-collective/agentlaunch-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://www.agentlaun.ch/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{site_host}/mcp",
      "variables": {
        "site_host": {
          "description": "Hostname of your self-hosted AgentLaunch deployment, without https:// (for example, launch.example.com).",
          "isRequired": true,
          "placeholder": "launch.example.com"
        }
      },
      "headers": [
        {
          "name": "Authorization",
          "description": "Your AgentLaunch API key, created on https://www.agentlaun.ch/connect (starts with rl_).",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "AgentLaunch API key (rl_...)",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
